---
import { publishedCvs } from '../lib/cvs';
---

{
  publishedCvs.length > 0 && (
    <span class="cvs">
      {publishedCvs.map((cv) => (
        <a href={cv.href} download>
          {cv.label}
        </a>
      ))}
    </span>
  )
}

<style>
  .cvs { display: inline-flex; flex-wrap: wrap; gap: 6px 14px; font: 400 14px var(--mono); }
  a { color: var(--accent); }
  a:hover { color: var(--ink); }
</style>
