---
import { education, employers } from '../content/experience';
import { glueNumberRanges } from '../lib/format';
import { monthLabel } from '../lib/tenure';
import CvLinks from './CvLinks.astro';
---

<section id="experience" class="section">
  <div class="section-head"><h2 class="display">Experience</h2></div>

  {
    employers.map((job) => (
      <article class="employer">
        <header>
          <div>
            <h3 class="display">{job.company}</h3>
            <p class="title">{job.title}</p>
          </div>
          <div class="when">
            <span>
              {monthLabel(job.from)} – {job.to ? monthLabel(job.to) : 'present'}
            </span>
            <span class="muted">{job.place}</span>
          </div>
        </header>
        {job.summary && <p class="summary">{job.summary}</p>}
        {job.areas && (
          <ul class="areas">
            {job.areas.map((area) => (
              <li>
                <span class="period">{area.label}</span>
                <div class="entry">
                  <p>{area.text}</p>
                </div>
              </li>
            ))}
          </ul>
        )}
        {job.periods.length > 0 && (
          <ol>
            {job.periods.map((period) => (
              <li>
                <span class="period">{glueNumberRanges(period.when)}</span>
                <div class="entry">
                  <span class="role">{period.role}</span>
                  <p>
                    {period.text}
                    {period.writeUp && (
                      <>
                        {' '}
                        <a href={`/work/${period.writeUp}`}>Write-up →</a>
                      </>
                    )}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        )}
      </article>
    ))
  }

  <article class="employer">
    <header>
      <div>
        <h3 class="display">Education</h3>
        <p class="title">{education.degree} · {education.school}</p>
      </div>
      <div class="when"><span>{education.year}</span></div>
    </header>
  </article>

  <div class="cv"><CvLinks /></div>
</section>

<style>
  .employer { padding: 32px 0 8px; border-bottom: 1px solid var(--line); }
  .employer header { display: flex; justify-content: space-between; gap: 12px 32px; flex-wrap: wrap; padding-bottom: 24px; }
  h3 { font-size: 24px; }
  .title { margin: 6px 0 0; font-size: 15px; color: var(--muted); }
  .when { display: grid; gap: 4px; font: 400 13px var(--mono); text-align: right; align-content: start; }
  /* Indented to line up with the text of the periods above. */
  .summary { margin: 0 0 24px 200px; max-width: 62ch; font-size: 16px; line-height: 1.6; text-wrap: pretty; }
  ol, .areas { list-style: none; margin: 0; padding: 0; }
  ol > li, .areas > li { display: flex; flex-wrap: wrap; gap: 8px 32px; padding: 20px 0; border-top: 1px solid var(--line); }
  .period { flex: 0 0 168px; font: 400 13px/1.5 var(--mono); padding-top: 2px; }
  .entry { flex: 1 1 400px; display: grid; gap: 6px; }
  .role { font-size: 14px; font-weight: 600; }
  .entry p { margin: 0; font-size: 16px; line-height: 1.6; max-width: 62ch; text-wrap: pretty; }
  .entry a { color: var(--accent); white-space: nowrap; font-size: 14px; }
  .entry a:hover { color: var(--ink); }
  .cv { padding-top: 24px; }
  @media (max-width: 720px) {
    .summary { margin-left: 0; }
  }
  @media (max-width: 560px) {
    .when { text-align: left; }
    .period { flex-basis: 100%; }
    .entry { flex-basis: 100%; }
  }
</style>
