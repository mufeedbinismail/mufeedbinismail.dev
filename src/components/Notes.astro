---
import { notes } from '../content/notes';
---

<section id="how-i-work" class="section">
  <div class="section-head"><h2 class="display">How I work</h2></div>
  <dl>
    {
      notes.map((note) => (
        <div>
          <dt>{note.title}</dt>
          <dd class="muted">{note.text}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr));
    column-gap: 48px;
  }
  dl > div { padding: 22px 0; border-bottom: 1px solid var(--line); display: grid; gap: 8px; align-content: start; }
  dt { font-weight: 600; font-size: 17px; }
  dd { margin: 0; font-size: 15px; line-height: 1.6; max-width: 62ch; text-wrap: pretty; }
</style>
