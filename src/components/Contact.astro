---
import { profile } from '../content/profile';
import CvLinks from './CvLinks.astro';
---

<section id="contact" class="section">
  <div class="section-head"><h2 class="display">Contact</h2></div>
  <ul class="links">
    <!-- Opened by ContactDialog in the header, which listens for [data-open-contact]. -->
    <li><button type="button" class="open" data-open-contact>Email &amp; phone</button></li>
    <li><a href={profile.linkedin}>LinkedIn ↗</a></li>
    <li><a href={profile.github}>GitHub ↗</a></li>
    <li><CvLinks /></li>
    <li class="muted">{profile.location}</li>
  </ul>
</section>

<style>
  #contact { padding-bottom: 56px; }
  .links {
    list-style: none;
    margin: 0;
    padding: 24px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    font: 400 14px var(--mono);
  }
  .open { font: inherit; color: var(--accent); background: none; border: 0; padding: 0; cursor: pointer; }
  .open:hover { color: var(--ink); }
</style>
