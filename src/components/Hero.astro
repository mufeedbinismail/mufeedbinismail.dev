---
import { profile } from '../content/profile';
import { yearOf, yearsSince } from '../lib/tenure';

const facts = [
  ['Now', `${profile.headline}, Direct Axis Technology`],
  ['Works on', 'AxisPro, the company’s ERP for UAE businesses (200+ clients); Acodax since 2026'],
  ['Based in', profile.location],
  ['Working since', `${yearOf(profile.careerStart)} · ${yearsSince(profile.careerStart)} years`],
  ['Works in', 'PHP and Laravel, JavaScript, MariaDB, Linux'],
  ['Knows', 'Finance and accounting, sales and purchase, CRM, HR (attendance, leave, payroll, workflow), document management, manufacturing, inventory and costing, fixed assets, UAE government services (Tasheel, Amer, Tawjeeh, Tadbeer, typing centres)'],
];
---

<section class="hero">
  <div class="name">
    <h1 class="display">{profile.name}</h1>
    <p>{profile.title}</p>
  </div>
  <dl>
    {
      facts.map(([term, detail]) => (
        <div class:list={{ wide: term === 'Knows' }}>
          <dt class="label">{term}</dt>
          <dd>{detail}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  /* minmax(0, 1fr): without it the column grows to the facts' widest content and the page scrolls sideways on phones. */
  .hero { padding: 88px 0 72px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 48px; }
  .name { display: grid; gap: 12px; }
  h1 { font-size: clamp(36px, 6vw, 60px); line-height: 1.05; }
  .name p { margin: 0; font-size: 19px; color: var(--muted); }
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 20px 32px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
    max-width: 960px;
  }
  dl > div { display: grid; gap: 6px; align-content: start; }
  /* The domain list is long; give it the whole row instead of a narrow column. */
  dl > .wide { grid-column: 1 / -1; }
  dl > .wide dd { max-width: 80ch; }
  dd { margin: 0; font-size: 15px; line-height: 1.5; text-wrap: pretty; }
  @media (max-width: 560px) {
    .hero { padding: 48px 0 40px; gap: 32px; }
    .name p { font-size: 17px; }
  }
</style>
