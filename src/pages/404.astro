---
import Base from '../layouts/Base.astro';
import { profile } from '../content/profile';
---

<Base title={`Page not found · ${profile.name}`} description="This page doesn’t exist.">
  <section class="missing">
    <span class="eyebrow">404</span>
    <h1 class="display">Nothing here.</h1>
    <p class="muted">The page may have moved, or the link has a typo.</p>
    <a href="/">← Back to the home page</a>
  </section>
</Base>

<style>
  .missing { padding: 120px 0 160px; display: grid; gap: 20px; justify-items: start; }
  h1 { font-size: clamp(36px, 6vw, 64px); }
  p { margin: 0; font-size: 18px; }
  a { color: var(--accent); font: 400 14px var(--mono); }
</style>
