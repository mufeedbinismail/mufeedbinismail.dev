---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Home from '../../components/Home.astro';
import WriteUpDrawer from '../../components/WriteUpDrawer';
import { profile } from '../../content/profile';
import { caseStudiesInOrder } from '../../lib/cases';

/**
 * A write-up's own URL: the home page with that write-up already open in the
 * drawer, so a reader who arrives from a link sees the rest of the site behind
 * it. The drawer is rendered open in the HTML, so it reads without JavaScript.
 */
export const getStaticPaths = (async () => {
  const studies = await caseStudiesInOrder();
  return studies.map((study) => ({ params: { slug: study.slug }, props: { study, studies } }));
}) satisfies GetStaticPaths;

const { study, studies } = Astro.props;
---

<Base title={`${study.title} · ${profile.name}`} description={study.summary} image={`/og/${study.slug}.png`} type="article">
  <Home />
  <WriteUpDrawer
    client:load
    studies={studies}
    siteName={profile.name}
    homeTitle={`${profile.name} · Full-stack developer`}
    initial={study.slug}
  />
</Base>
