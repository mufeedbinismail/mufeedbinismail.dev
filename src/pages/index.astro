---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import WriteUpDrawer from '../components/WriteUpDrawer';
import { caseStudiesInOrder } from '../lib/cases';
import { profile } from '../content/profile';
import { yearsSince } from '../lib/tenure';
import { education } from '../content/experience';
import { stack } from '../content/stack';

// Who this site is about, for search engines. No email or phone: those stay out of the page.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.headline,
  url: Astro.site?.href,
  image: new URL('/og/home.png', Astro.site).href,
  sameAs: [profile.linkedin, profile.github],
  address: { '@type': 'PostalAddress', addressLocality: 'Dubai', addressCountry: 'AE' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: education.school },
  knowsAbout: stack.filter((g) => g.group !== 'Domain').flatMap((g) => g.items),
};
const studies = await caseStudiesInOrder();
const title = `${profile.name} · Full-stack developer`;
const description = `Full-stack developer in Dubai, ${yearsSince(profile.careerStart)} years in. Builds and maintains business software (accounting, HR and payroll) in PHP, Laravel, JavaScript and MariaDB, and the servers it runs on.`;
---

<Base title={title} description={description} structuredData={person}>
  <Home />
  <WriteUpDrawer client:load studies={studies} siteName={profile.name} homeTitle={title} />
</Base>
